{
  "manifest_version": 3,
  "name": "X Ad Blocker",
  "version": "1.0.0",
  "description": "Hide promoted/ad posts on X (Twitter)",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
